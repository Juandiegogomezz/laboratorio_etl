                "api",
                "v1",
                "etl",
                "reset"
              ]
            },
            "description": "Vacía MongoDB (delete_many) y MySQL (TRUNCATE). Esperado: 200."
          },
          "response": []
        },
        {
          "name": "2. Extraer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/etl/extraer",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "etl",
                "extraer"
              ]
            },
            "description": "API -> MongoDB. Esperado: 201 con nuevos = 50.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "3. Extraer (idempotencia)",
