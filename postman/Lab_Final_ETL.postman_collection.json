                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "etl",
                "extraer"
              ]
            },
            "description": "Segunda vez. Esperado: nuevos = 0, ya_existentes = 50.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
